{
    "version": "1.0.5",
    "layout_name": "course_list",
    "extends": "_user_base",
    "meta": {
        "title": "$t:glitter-learning.user.courses.title",
        "description": "$t:glitter-learning.user.courses.description"
    },
    "data_sources": [
        {
            "id": "courses",
            "type": "api",
            "endpoint": "/api/modules/glitter-learning/learning/courses",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": false,
            "loading_strategy": "blocking",
            "params": {
                "page": "{{query.page}}"
            }
        }
    ],
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "glitter-learning-user-shell",
                    "role": "main"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "glitter-learning-user-page-header"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "H1",
                                        "text": "$t:glitter-learning.user.courses.title"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "text": "$t:glitter-learning.user.courses.description"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/learning/me",
                                    "className": "glitter-learning-user-button"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:glitter-learning.user.my_learning.title"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{courses !== undefined && (courses?.data?.data ?? []).length === 0}}",
                        "props": {
                            "className": "glitter-learning-user-empty"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H2",
                                "text": "$t:glitter-learning.user.courses.empty_title"
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "text": "$t:glitter-learning.user.courses.empty_description"
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{(courses?.data?.data ?? []).length > 0}}",
                        "props": {
                            "className": "glitter-learning-user-grid"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "iteration": {
                                    "source": "{{courses?.data?.data ?? []}}",
                                    "item_var": "course"
                                },
                                "props": {
                                    "className": "glitter-learning-user-card glitter-learning-user-course-card"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "A",
                                        "if": "{{course.thumbnail_url}}",
                                        "props": {
                                            "href": "/learning/courses/{{course.slug}}",
                                            "className": "glitter-learning-user-card-media"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Img",
                                                "props": {
                                                    "src": "{{course.thumbnail_url}}",
                                                    "alt": "{{course.title}}",
                                                    "loading": "lazy"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "glitter-learning-user-card-body"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H2",
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "A",
                                                        "props": {
                                                            "href": "/learning/courses/{{course.slug}}"
                                                        },
                                                        "text": "{{course.title}}"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "if": "{{course.introduction}}",
                                                "props": {
                                                    "className": "glitter-learning-user-card-introduction"
                                                },
                                                "text": "{{course.introduction}}"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "glitter-learning-user-card-meta"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "glitter-learning-user-badge"
                                                        },
                                                        "text": "$t:glitter-learning.user.courses.lesson_count|count={{course.lessons_count ?? 0}}"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "A",
                                                "props": {
                                                    "href": "/learning/courses/{{course.slug}}",
                                                    "className": "glitter-learning-user-button"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:glitter-learning.user.courses.view_details"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Nav",
                        "if": "{{(courses?.data?.last_page ?? 1) > 1}}",
                        "props": {
                            "className": "glitter-learning-user-actions",
                            "aria-label": "$t:glitter-learning.user.courses.title"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "A",
                                "if": "{{(courses?.data?.current_page ?? 1) > 1}}",
                                "props": {
                                    "href": "/learning?page={{(courses?.data?.current_page ?? 1) - 1}}",
                                    "className": "glitter-learning-user-button"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:glitter-learning.common.previous"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "if": "{{(courses?.data?.current_page ?? 1) < (courses?.data?.last_page ?? 1)}}",
                                "props": {
                                    "href": "/learning?page={{(courses?.data?.current_page ?? 1) + 1}}",
                                    "className": "glitter-learning-user-button"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:glitter-learning.common.next"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
